# Prisma / MongoDB
DATABASE_URL="mongodb://localhost:27017/tradexfloor"

# Auth.js (JWT sessions)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
AUTH_TRUST_HOST=true
AUTH_URL="http://localhost:3000"
AUTH_SESSION_MAX_AGE=604800
AUTH_SESSION_UPDATE_AGE=86400

# Optional legacy alias supported during migration
# NEXTAUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
# NEXTAUTH_URL="http://localhost:3000"

# API / browser access
CORS_ORIGINS="http://localhost:3000"

# Optional Redis
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Google OAuth
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Email
# GMAIL_USER=""
# GMAIL_APP_PASSWORD=""
